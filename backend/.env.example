# ---- Copy this file to ".env" and fill the empty values ----

# PostgreSQL. Replace YOUR_PASSWORD with the password you set for the "postgres" user.
# (If the password has special characters like @ or #, URL-encode them, e.g. @ -> %40)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/talentos

# Secret used to sign login tokens. Any long random text. If left empty, a temporary one is
# generated each time the server starts (everyone gets logged out on restart).
JWT_SECRET=

# Gemini (Google AI Studio key). If empty, the app still works using built-in fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OTP: "fixed" = always accept DEV_OTP (for development). "email" = real random OTP (needs SMTP below).
OTP_MODE=fixed
DEV_OTP=1234

# Browser origins allowed to call this API (your React app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only needed when OTP_MODE=email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
